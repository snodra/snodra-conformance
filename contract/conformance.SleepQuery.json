{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conformance.SleepQuery.json",
  "title": "conformance.SleepQuery",
  "description": "conformance.Sleep as a query: the target the runner cancels as a scatter-gather target (<id>#<n>), as snodra-server does only for queries.",
  "x-snodra": {
    "conformanceVersion": 1,
    "kind": "query",
    "mode": "unary",
    "servedBy": "service",
    "registeredIn": "query_types"
  },
  "$defs": {
    "payload": {
      "type": "object",
      "properties": {
        "ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "answer": {
      "type": "object",
      "required": [
        "instanceId",
        "sleptMs"
      ],
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "sleptMs": {
          "type": "integer"
        }
      }
    }
  }
}
